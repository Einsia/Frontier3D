# This file contains placeholders. Replace the URLs, keys and tested model.
# File values override inherited provider settings; no credential is distributed.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-your-generator-key
OPENAI_MODEL=replace-with-your-model
GENERATOR_CODEX_BIN=codex
GENERATOR_RUNTIME=docker
GENERATOR_DOCKER_IMAGE=3dbench-codex:0.163.0
# Claude, Qwen, MiniMax and Doubao use ClaudeCode on L1/L2/L3.
GENERATOR_CLAUDE_BIN=claude
GENERATOR_CLAUDE_DOCKER_IMAGE=3dbench-claude:2.1.268
GENERATOR_NATIVE_DOCKER_IMAGE=3dbench-native:contract-v1
GENERATOR_DSH_BIN=dsh
GENERATOR_KIMI_BIN=kimi
GENERATOR_ZCODE_BIN=zcode
GENERATOR_GEMINI_BIN=gemini
GENERATOR_TIMEOUT=57600
GENERATOR_MAX_ATTEMPTS=1
GENERATOR_REASONING_EFFORT=auto
# The L1/L2 harness owns six total attempts and the shared 115200-second budget.

# Independent image-capable judge; keep the same judge across tested models.
VLM_BASE_URL=https://api.example.com/v1
VLM_API_KEY=replace-with-your-judge-key
VLM_MODEL=gpt-6-astra
VLM_REASONING_EFFORT=medium
VLM_TIMEOUT=600
VLM_MAX_ATTEMPTS=3
VLM_CODEX_BIN=codex

# CLI --blender > exported THREEDBENCH_BLENDER > this file > checkout default.
# Relative Blender paths are resolved against this env file directory.
# THREEDBENCH_BLENDER=/absolute/path/to/blender-5.2.1-linux-x64/blender

# L3 uses the same OPENAI_*/VLM_* providers above and the same benchmark CLI.
# For Doubao, install @anthropic-ai/claude-code@2.1.268 here; Codex is optional.
# Required for --level 3 or an unfiltered --all run; see the root README.
# L3_UE_ROOT is the original licensed UE 5.8.3 build location.
# Candidate and evaluator must be separate writable copies, also separate from it.
# L3_UE_ROOT=/absolute/path/to/licensed/UnrealEngine
# L3_CANDIDATE_ENGINE=/absolute/path/to/candidate-engine
# L3_EVALUATOR_ENGINE=/absolute/path/to/evaluator-engine
# L3_NATIVE_CLI=/absolute/path/to/l3-cli/node_modules
# L3_ASSET_ROOT=/absolute/path/to/offline-l3-assets
L3_UE_IMAGE=3dbench-l3-agent:ue5.8.3-codex0.163.0
L3_GPU=0
# Optional advanced provider overrides: private JSON with base_url and api_key.
# L3_PROVIDER_DIR=/private/path/to/providers
# L3_MATRIX_JUDGE_PROVIDER=/private/path/to/judge.json
