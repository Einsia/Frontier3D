  "l1_protocol": {
    "version": "l1-requirements-v1",
    "requirements": [
      {
        "id": "public_clause_02",
        "text": "Reconstruct the wall cabinet with its upward-opening framed door, two top hinges, and the two articulated telescoping support struts. Retain the cabinet cavity, thin panels, door frame and translucent infill. The door must rotate about its upper hinge axis; each strut must pivot at its cabinet and door attachments and slide along its own axis while remaining attached. Do not fake opening by translating the entire door or stretching rigid parts. No pressure or spring-force simulation is required.",
        "source": "instruction.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "primary_similarity",
          "native_state_materials"
        ],
        "reason": "Only native primary appearance is measured; semantic geometry/visible-surface/region completeness is not verified. Declared frames receive no-bitmap audits only; motion/attachments/rigidity are not measured."
      },
      {
        "id": "public_clause_03",
        "text": "Use real editable three-dimensional geometry. Preserve continuous curvature, thickness, recesses, openings, thin structures, connections and occlusions. Distinct components should be editable objects or clearly separable mesh islands; organic surfaces may remain continuous. Exact source topology, vertex count and object names are not required. Image planes or camera-facing shells are not substitutes for full geometry.",
        "source": "instruction.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "primary_similarity"
        ],
        "reason": "Only native primary appearance is measured; semantic geometry/visible-surface/region completeness is not verified."
      },
      {
        "id": "public_clause_04",
        "text": "Use metres, Z up, and a maximum overall span of 1.000 m with 2% tolerance, excluding cameras and lights. This is a task scale convention, not a real-world measurement. Infer other proportions from the images.",
        "source": "instruction.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "primary_similarity"
        ],
        "reason": "Only native primary appearance is measured; semantic geometry/visible-surface/region completeness is not verified."
      },
      {
        "id": "public_clause_05",
        "text": "The four main views show the open pose. input/closed.png and input/half_open.png use the same primary camera to show the closed and intermediate poses. Follow input/motion.json at 24 fps: frame 1 closed, 31 half open, 61 open, 91 half closed and 121 closed again. Animate continuously through the cycle; match the visible poses, attachment relationships and rotation direction rather than the exact source easing. Measure the 1 m span at frame 1. Keep rigid component shape and scale constant. Save the Blender scene at frame 61 for inspection; preserve the full 1–121 animation in Blender and GLB. Render main.png at frame 61. An exploded view is not required.",
        "source": "instruction.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "primary_similarity",
          "native_state_materials"
        ],
        "reason": "Only native primary appearance is measured; semantic geometry/visible-surface/region completeness is not verified. Declared frames receive no-bitmap audits only; motion/attachments/rigidity are not measured."
      },
      {
        "id": "public_clause_06",
        "text": "Render main.png at 1000 x 1000 pixels from a camera matching input/reference.png, using neutral studio lighting, Cycles, AgX and exposure 0. Retain the camera and lighting in scene.blend.",
        "source": "instruction.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "primary_similarity",
          "saved_camera",
          "saved_resolution",
          "main_render_consistency"
        ],
        "reason": "Only native primary appearance is measured; semantic geometry/visible-surface/region completeness is not verified."
      },
      {
        "id": "delivery",
        "text": "Required native/GLB/image/source/README outputs and clean rebuild",
        "source": "harness/README.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "export",
          "main_loadable",
          "main_dimensions",
          "main_format",
          "readme",
          "reproducible"
        ],
        "reason": "Current visual pilot only; not full EVALUATION coverage."
      },
      {
        "id": "procedural_materials",
        "text": "Existing pilot: no bitmap inputs; pure colour and procedural nodes allowed",
        "source": "harness/README.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "native_procedural_materials",
          "glb_procedural_materials",
          "native_state_materials"
        ],
        "reason": "Current visual pilot only; not full EVALUATION coverage."
      },
      {
        "id": "seed_quality",
        "text": "Baseline and seed 0/1/2 independently inspected; minimum native image score",
        "source": "harness/README.md",
        "required": true,
        "applicable": true,
        "implementation": "partial",
        "check_ids": [
          "all_seed_quality"
        ],
        "reason": "Current visual pilot only; not full EVALUATION coverage."
      }
    ]
  },
