{
  "version": "scalable-v1.0.0",
  "profile": "L2",
  "mode": "text",
  "required_artifacts": ["solution.py", "scene.blend", "main.png", "alternate.png"],
  "scene": "scene.blend",
  "critical_constraints": ["content_objects", "main_camera", "render_main"],
  "seeds": [20260914, 20260915, 20260916],
  "tolerances": {"scene_extent_m": 10.0, "ground_contact_m": 0.25, "near_m": 12.0},
  "render_views": [],
  "checks": {
    "content": [
      {"id": "content_objects", "metric": "object_coverage", "group": "required_objects", "params": {"rules": [
        {"pattern": "Building|column|beam|slab|Stair", "min_count": 1},
        {"pattern": "Crane|crane|jib|Hoist", "min_count": 1},
        {"pattern": "Mixer|mixer|Dump|dump", "min_count": 2},
        {"pattern": "road|Road", "min_count": 1},
        {"pattern": "Fence|fence|Gate|gate", "min_count": 1},
        {"pattern": "storage|Storage|material|Material|Aggregate|Lumber|Cement|pallet|stack|Pipe", "min_count": 1}
      ]}},
      {"id": "scene_extent", "metric": "numeric", "group": "site_scale", "params": {"path": "/scene/dimensions", "expected": [40.0, 30.0, 12.0], "tolerance": "scene_extent_m"}}
    ],
    "spatial": [
      {"id": "main_camera", "metric": "camera_config", "group": "cameras", "importance": "high", "params": {"camera": "Main Camera", "projection": "ORTHO", "resolution": [1280, 960], "elevation": [45.0, 75.0]}},
      {"id": "alternate_camera", "metric": "camera_config", "group": "cameras", "importance": "high", "params": {"camera": "Alternate Camera", "projection": "ORTHO", "resolution": [1280, 960]}},
      {"id": "road_workzone_relation", "metric": "relation", "group": "layout", "params": {"left": "Access road", "right": "Work zone", "relation": "near", "tolerance": "near_m"}}
    ],
    "physics": [
      {"id": "grounded_equipment", "metric": "ground_contact", "group": "support", "params": {"selector": {"pattern": "Tire|Building slab|Crane mast|Mixer|Dump"}, "max_height": "ground_contact_m"}},
      {"id": "collision_budget", "metric": "collision_free", "group": "collision", "params": {"max_pairs": 300}}
    ],
    "visual": [
      {"id": "render_main", "metric": "image_validity", "group": "renders", "params": {"path": "/artifacts/main.png/path"}},
      {"id": "render_alternate", "metric": "image_validity", "group": "renders", "params": {"path": "/artifacts/alternate.png/path"}}
    ],
    "structure": [
      {"id": "editable_scene", "metric": "equals", "group": "editable", "params": {"path": "/scene/all_editable", "expected": true}},
      {"id": "scene_units", "metric": "equals", "group": "units", "params": {"path": "/scene/unit_system", "expected": "METRIC"}}
    ],
    "robust": [
      {"id": "seed_reproducibility", "metric": "seed_success", "group": "reruns"},
      {"id": "delivery_main", "metric": "equals", "group": "delivery", "params": {"path": "/artifacts/main.png/loadable", "expected": true}},
      {"id": "delivery_alternate", "metric": "equals", "group": "delivery", "params": {"path": "/artifacts/alternate.png/loadable", "expected": true}}
    ]
  }
}
