# Legacy internal/Harbor provisioning template. Public CLI: use the root .env.example.
# Paths only; no working credentials.
L3_EXPERIMENT_BATCH=/absolute/path/to/new-l3-campaign
L3_UE_ROOT=/absolute/path/to/licensed/UnrealEngine
L3_UE_IMAGE=your-local-ue-runtime-image
L3_NATIVE_CLI=/absolute/path/to/native-cli/node_modules
L3_PROVIDER_DIR=/private/path/to/provider-config-directory
L3_MATRIX_JUDGE_PROVIDER=/private/path/to/judge.json
L3_ASSET_ROOT=/absolute/path/to/offline-l3-assets
# Required offline libraries:
# kenney-voxel-1.0-tiles, kenney-suite-20261023, polyhaven-2k-2026-10-16
# Private files: $L3_PROVIDER_DIR/openai.json uses {"base_url": "https://.../v1", "api_key": "..."}.
# The trusted judge provider uses the same schema and is supplied via --provider.
# Candidate and trusted evaluator engines must be separate writable copies.
