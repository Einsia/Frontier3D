FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 git \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global \
       @deepseek-ai/dsh@0.2.1-rc.2 \
       @moonshot-ai/kimi-code@2.3.2 \
       zcode-app-cli@3.16.3-40 \
       @google/gemini-cli@0.67.0 \
    && npm cache clean --force

WORKDIR /workspace
